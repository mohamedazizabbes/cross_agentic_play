# --- LLM provider ---
# Choose which LLM backend drives the debate: gemini | groq | openrouter
LLM_PROVIDER=gemini

# --- Google Gemini (LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (LLM_PROVIDER=groq) ---
# Free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# Free API key from https://openrouter.ai/settings/keys (free models are marked :free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
