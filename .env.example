# --- LLM provider ---
# Choose which LLM backend drives the debate: gemini | groq | openrouter
LLM_PROVIDER=gemini

# --- Google Gemini (LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (LLM_PROVIDER=groq) ---
# Free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# Free API key from https://openrouter.ai/settings/keys (free models are marked :free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# --- Local quota tracking (optional) ---
# Tracks per-provider/per-day LLM call counts in a local JSON file and prints a
# summary (e.g. "Gemini: 14/20 used today") before each run.
QUOTA_STATE_FILE=.quota_state.json
QUOTA_DAILY_LIMIT=20

# --- On-disk response cache (optional) ---
# Caches LLM responses by (provider, model, prompt) so repeated runs don't burn quota.
# Disable per-run with `python main.py --no-cache`.
LLM_CACHE_DIR=.cache
LLM_CACHE_ENABLED=1
