# --- LLM provider ---
# Choose which LLM backend drives the debate: gemini | openai | anthropic | groq | openrouter
LLM_PROVIDER=gemini

# --- Google Gemini (LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (LLM_PROVIDER=openai) ---
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Anthropic (LLM_PROVIDER=anthropic) ---
# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Groq (LLM_PROVIDER=groq) ---
# Free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# Free API key from https://openrouter.ai/settings/keys (free models are marked :free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# --- Local quota tracking (optional) ---
QUOTA_STATE_FILE=.quota_state.json
QUOTA_DAILY_LIMIT=20

# --- On-disk response cache (optional) ---
LLM_CACHE_DIR=.cache
LLM_CACHE_ENABLED=1
